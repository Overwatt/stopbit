   "css": ".ds-list{font:16px/1.45 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;font-variant-numeric:tabular-nums;max-width:380px;padding:16px;background:var(--ground,#dcebf1)}.ds-list a{display:grid;grid-template-columns:18px minmax(4.5rem,1fr) fit-content(72%);gap:12px;align-items:center;min-height:50px;box-sizing:border-box;padding:8px 16px;margin-bottom:4px;border-radius:8px;color:var(--ink,#0b2230);text-decoration:none;transition:background .15s}.ds-list b{font-size:1.0625rem;font-weight:650;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-list em{font-style:normal;color:var(--soft,#2d5468);text-align:right;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-list svg{width:14px;height:14px;display:block}.m-ok{color:var(--ok,#17703d)}.m-idle{color:var(--idle,#4e6f7f)}.m-warn{color:var(--warn,#7d4b00)}.m-bad{color:var(--bad,#a3211a)}.ds-list a:hover{background:color-mix(in srgb,var(--sheet,#ffffff) 55%,transparent)}.ds-list a.ds-bad{background:var(--bad-bg,#ffe1dc);color:var(--bad,#a3211a)}.ds-list a.ds-bad em{color:var(--bad,#a3211a)}.ds-list a.ds-warn,.ds-list a.ds-warn em{color:var(--warn,#7d4b00)}.ds-list a[aria-current]{background:var(--sheet,#ffffff)}.ds-list a.ds-bad[aria-current]{background:var(--bad-bg,#ffe1dc);box-shadow:inset 0 0 0 2px var(--bad,#a3211a)}.ds-list a:focus-visible{outline:2px solid var(--sea,#1683b8);outline-offset:2px}"
  },
  {
   "name": "Primary button",
   "kind": "button",
   "refersTo": "button-primary",
   "description": "The one action a form or report has.",
   "html": "<button class=\"ds-btn-p\">Edit port</button>",
   "css": ".ds-btn-p{font:16px/1.45 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;font-variant-numeric:tabular-nums;font-weight:600;border:0;border-radius:6px;min-height:44px;padding:9px 18px;cursor:pointer;transition:background .15s;background:var(--accent,#0d4a68);color:var(--accent-ink,#ffffff)}.ds-btn-p:hover{background:var(--accent-h,#0a3b53)}.ds-btn-p:active{background:var(--accent-p,#072c3f)}.ds-btn-p:focus-visible{outline:2px solid var(--sea,#1683b8);outline-offset:2px}"
  },
  {
   "name": "Button",
