   "css": ".ds-btn-d,.ds-btn-d:hover{font:16px/1.45 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;font-variant-numeric:tabular-nums;font-weight:600;border:0;border-radius:6px;min-height:44px;padding:9px 18px;cursor:pointer;transition:background .15s;background:var(--bad-bg,#ffe1dc);color:var(--bad,#a3211a)}.ds-btn-d:focus-visible{outline:2px solid var(--sea,#1683b8);outline-offset:2px}"
